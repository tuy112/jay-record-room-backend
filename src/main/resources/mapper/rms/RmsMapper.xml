<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="rms">

    <!-- RMS 조회 결과 매핑 -->
    <resultMap id="rmsResultMap"
               type="record_backend.rms.vo.RmsVO">

        <!-- 기본 정보 -->
        <id property="id" column="id"/>
        <result property="topic" column="topic"/>
        <result property="title" column="title"/>
        <result property="subtitle" column="subtitle"/>
        <result property="content" column="content"/>

        <!-- 로그 정보 -->
        <result property="logType" column="log_type"/>
        <result property="systemName" column="system_name"/>
        <result property="dbType" column="db_type"/>
        <result property="sqlId" column="sql_id"/>
        <result property="sourceClass" column="source_class"/>

        <!-- SQL 분석 -->
        <result property="originalSql" column="original_sql"/>
        <result property="optimizedSql" column="optimized_sql"/>
        <result property="relatedTables" column="related_tables"/>

        <!-- 실행 시간 -->
        <result property="executionMs" column="execution_ms"/>
        <result property="optimizedMs" column="optimized_ms"/>

        <!-- 분석 및 해결 방법 -->
        <result property="analysis" column="analysis"/>
        <result property="solution" column="solution"/>

        <!-- 등록 및 수정 일시 -->
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>

    </resultMap>

    <!-- 공통 조회 컬럼 -->
    <sql id="rmsColumns">
        id,
        topic,
        title,
        subtitle,
        content,
        log_type,
        system_name,
        db_type,
        sql_id,
        source_class,
        original_sql,
        optimized_sql,
        related_tables,
        execution_ms,
        optimized_ms,
        analysis,
        solution,
        created_at,
        updated_at
    </sql>

    <!-- 전체 목록 조회 -->
    <select id="selectRmsList" resultMap="rmsResultMap">
        SELECT
        <include refid="rmsColumns"/>
        FROM TB_RMSPOST
        ORDER BY created_at DESC, id DESC
    </select>

    <!-- 상세 조회 -->
    <select id="selectRms"
            parameterType="long"
            resultMap="rmsResultMap">
        SELECT
        <include refid="rmsColumns"/>
        FROM TB_RMSPOST
        WHERE id = #{id}
    </select>

    <!-- 등록 -->
    <insert id="insertRms"
            parameterType="record_backend.rms.vo.RmsVO"
            useGeneratedKeys="true"
            keyProperty="id"
            keyColumn="id">

        INSERT INTO TB_RMSPOST (
        topic,
        title,
        subtitle,
        content,
        log_type,
        system_name,
        db_type,
        sql_id,
        source_class,
        original_sql,
        optimized_sql,
        related_tables,
        execution_ms,
        optimized_ms,
        analysis,
        solution
        )
        VALUES (
        #{topic},
        #{title},
        #{subtitle},
        #{content},
        #{logType},
        #{systemName},
        #{dbType},
        #{sqlId},
        #{sourceClass},
        #{originalSql},
        #{optimizedSql},
        #{relatedTables},
        #{executionMs},
        #{optimizedMs},
        #{analysis},
        #{solution}
        )

    </insert>

    <!-- 수정 -->
    <update id="updateRms"
            parameterType="record_backend.rms.vo.RmsVO">

        UPDATE TB_RMSPOST
        SET
        topic = #{topic},
        title = #{title},
        subtitle = #{subtitle},
        content = #{content},
        log_type = #{logType},
        system_name = #{systemName},
        db_type = #{dbType},
        sql_id = #{sqlId},
        source_class = #{sourceClass},
        original_sql = #{originalSql},
        optimized_sql = #{optimizedSql},
        related_tables = #{relatedTables},
        execution_ms = #{executionMs},
        optimized_ms = #{optimizedMs},
        analysis = #{analysis},
        solution = #{solution},
        updated_at = CURRENT_TIMESTAMP
        WHERE id = #{id}

    </update>

    <!-- 삭제 -->
    <delete id="deleteRms" parameterType="long">
        DELETE FROM TB_RMSPOST
        WHERE id = #{id}
    </delete>

</mapper>
